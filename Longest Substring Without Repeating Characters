LEETCODE PROBLEM SOLVING
PROBLEM-> Longest Substring Without Repeating Characters

class Solution {
    public int lengthOfLongestSubstring(String s) {
        int[] v = new int[256];      
        for (int i = 0; i < 256; i++)
            v[i] = -1;
        int l = 0, ans = 0;
        for (int r = 0; r < s.length(); r++) {
            if (v[s.charAt(r)] >= l)
                l = v[s.charAt(r)] + 1;
            v[s.charAt(r)] = r;
            ans = Math.max(ans, r - l + 1);
        }
        return ans;
    }
}
 
