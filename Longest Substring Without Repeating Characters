LEETCODE PROBLEM SOLVING
PROBLEM-> Longest Substring Without Repeating Characters

class Solution {
public:
    int lengthOfLongestSubstring(string s) {
        vector<int> v(256, -1);
        int l = 0, ans = 0;

        for (int r = 0; r < s.size(); r++) {
            if (v[s[r]] >= l)
                l = v[s[r]] + 1;

            v[s[r]] = r;
            ans = max(ans, r - l + 1);
        }

        return ans;
    }
};
