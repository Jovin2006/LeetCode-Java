LEETCODE PROBLEM SOLVING 
PROBLEM-> Median of Two Sorted Arrays

class Solution {
    public double findMedianSortedArrays(int[] nums1, int[] nums2) {
        int[] v = new int[nums1.length + nums2.length];
        int k = 0;
        for (int x : nums1)
            v[k++] = x;
        for (int x : nums2)
            v[k++] = x;
        Arrays.sort(v);
        int n = v.length;
        if (n % 2 == 1)
            return v[n / 2];
        return (v[n / 2] + v[n / 2 - 1]) / 2.0;
    }
}
