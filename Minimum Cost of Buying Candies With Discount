LEETCODE PROBLEM SOLVING
PROBLEM-> Minimum Cost of Buying Candies With Discount

class Solution {
    public int minimumCost(int[] cost) {

        Arrays.sort(cost);

        int sum = 0;

        for(int i = cost.length - 1, count = 1; i >= 0; i--, count++) {

            if(count % 3 != 0)
                sum += cost[i];
        }

        return sum;
    }
}
