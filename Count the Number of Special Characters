LEETCODE PROBLEM SOLVING
PROBLEM-> Count the Number of Special Characters 

class Solution { 
public:
    int numberOfSpecialChars(string word) {
        int count = 0;

        for (char ch = 'a'; ch <= 'z'; ch++) {
            bool small = false, capital = false;

            for (int i = 0; i < word.size(); i++) {
                if (word[i] == ch)
                    small = true;

                if (word[i] == ch - 32)
                    capital = true;
            }

            if (small && capital)
                count++;
        }

        return count;
    }
};
