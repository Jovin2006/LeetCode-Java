LEETCODE PROBLEM SOLVING
PROBLEM -> Roman To Integer

class Solution {
    public int romanToInt(String s) {

        int ans = 0;

        for(int i = 0; i < s.length(); i++) {

            char c = s.charAt(i);

            if(c == 'I') ans += 1;
            if(c == 'V') ans += 5;
            if(c == 'X') ans += 10;
            if(c == 'L') ans += 50;
            if(c == 'C') ans += 100;
            if(c == 'D') ans += 500;
            if(c == 'M') ans += 1000;

            if(i > 0) {

                if(s.charAt(i) == 'V' && s.charAt(i - 1) == 'I') ans -= 2;
                if(s.charAt(i) == 'X' && s.charAt(i - 1) == 'I') ans -= 2;

                if(s.charAt(i) == 'L' && s.charAt(i - 1) == 'X') ans -= 20;
                if(s.charAt(i) == 'C' && s.charAt(i - 1) == 'X') ans -= 20;

                if(s.charAt(i) == 'D' && s.charAt(i - 1) == 'C') ans -= 200;
                if(s.charAt(i) == 'M' && s.charAt(i - 1) == 'C') ans -= 200;
            }
        }

        return ans;
    }
}
