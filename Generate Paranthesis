LEETCODE PROBLEM SOLVING 
PROBLEM -> Generate Paranthesis

class Solution {

    List<String> ans = new ArrayList<>();

    public List<String> generateParenthesis(int n) {
        solve("", n, n);
        return ans;
    }

    public void solve(String s, int open, int close) {

        if(open == 0 && close == 0) {
            ans.add(s);
            return;
        }

        if(open > 0)
            solve(s + "(", open - 1, close);

        if(close > open)
            solve(s + ")", open, close - 1);
    }
}
