LEETCODE PROBLEM SOLVING 
PROBLEM ->Number of Ways to Assign Edge Weights I

class Solution {

    public int assignEdgeWeights(int[][] edges) {

        int n = edges.length + 1;
        int mod = 1000000007;

        ArrayList<Integer>[] g = new ArrayList[n + 1];

        for(int i = 1; i <= n; i++)
            g[i] = new ArrayList<>();

        for(int[] e : edges) {
            g[e[0]].add(e[1]);
            g[e[1]].add(e[0]);
        }

        Queue<Integer> q = new LinkedList<>();
        boolean[] vis = new boolean[n + 1];

        q.add(1);
        vis[1] = true;

        int depth = -1;

        while(!q.isEmpty()) {

            int size = q.size();
            depth++;

            for(int i = 0; i < size; i++) {

                int node = q.poll();

                for(int next : g[node]) {
                    if(!vis[next]) {
                        vis[next] = true;
                        q.add(next);
                    }
                }
            }
        }

        long ans = 1;

        for(int i = 1; i < depth; i++) {
            ans = (ans * 2) % mod;
        }

        return (int)ans;
    }
}
